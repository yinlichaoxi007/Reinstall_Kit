{
  "_说明": "备份清单配置。增删备份项只改这里；本机如需不同清单，复制为 backup.local.json 后修改（已被 git 忽略，会整体覆盖本文件）。路径均相对当前用户目录，系统项除外。备份落点由 kit.config.json 的 backupRoot 决定。",
  "categories": [
    {
      "id": "ai-tools",
      "name": "AI / 开发工具配置",
      "default": true,
      "dirs": [
        { "rel": "AppData\\Local\\JetBrains", "note": "JetBrains 配置/索引/插件" },
        { "rel": "AppData\\Roaming\\JetBrains", "note": "JetBrains 用户设置" },
        { "rel": "AppData\\Local\\Microsoft\\VisualStudio", "note": "VS 用户配置/扩展" },
        { "rel": "AppData\\Roaming\\Microsoft\\VisualStudio", "note": "VS 漫游设置" },
        { "rel": "AppData\\Roaming\\com.qodercn.app.stable", "note": "Qoder CN 真实数据" },
        { "rel": "AppData\\Roaming\\com.qoder.app.stable", "note": "Qoder 数据" },
        { "rel": "AppData\\Roaming\\QwenWorkCN", "note": "千问办公" },
        { "rel": "AppData\\Roaming\\@deepseek-ai", "note": "DeepSeek Harness" },
        { "rel": "AppData\\Roaming\\ichat", "note": "iChat" },
        { "rel": "AppData\\Local\\github-copilot", "note": "Copilot 插件数据" },
        { "rel": "AppData\\Local\\ai_env_clone", "note": "AI 环境克隆" },
        { "rel": "AppData\\Local\\WorkBuddy", "note": "WorkBuddy 桌面端缓存" },
        { "rel": "AppData\\Local\\Lertaro", "note": "Lertaro 配置/别名/搜索历史" },
        { "rel": "AppData\\Roaming\\Mozilla", "note": "Firefox 配置/书签" },
        { "rel": "AppData\\Local\\Docker", "note": "Docker Desktop 用户配置" }
      ]
    },
    {
      "id": "dev-env",
      "name": "开发环境与缓存",
      "default": true,
      "dirs": [
        { "rel": ".docker", "note": "Docker CLI 配置" },
        { "rel": ".m2", "note": "Maven 本地仓库" },
        { "rel": ".npm", "note": "npm 全局包" },
        { "rel": ".local", "note": "Python 用户级包" },
        { "rel": ".cache", "note": "各类缓存（可选）" },
        { "rel": ".claude", "note": "Claude Code 配置" }
      ]
    },
    {
      "id": "keys",
      "name": "SSH / GPG 密钥",
      "default": true,
      "dirs": [
        { "rel": ".ssh", "note": "★ SSH 私钥" },
        { "rel": ".gnupg", "note": "★ GPG 私钥" }
      ]
    },
    {
      "id": "personal",
      "name": "个人文件",
      "default": true,
      "dirs": [
        { "rel": "Documents", "note": "文档（C 盘这份与 D 盘有差异）" },
        { "rel": "Desktop", "note": "桌面残留" },
        { "rel": "Downloads", "note": "下载残留" },
        { "rel": "Pictures", "note": "图片" },
        { "rel": "AppData\\Roaming\\Microsoft\\Windows\\Recent", "note": "最近使用记录（可选）" },
        { "rel": "Favorites", "note": "IE/旧版 Edge 收藏夹" }
      ]
    },
    {
      "id": "root-files",
      "name": "用户目录单文件",
      "default": true,
      "files": [
        { "rel": ".claude.json", "note": "Claude Code 索引" },
        { "rel": ".gitconfig", "note": "★ Git 全局配置" },
        { "rel": ".bash_history", "note": "命令行历史" },
        { "rel": ".viminfo", "note": "vim 状态" },
        { "rel": ".lesshst", "note": "less 历史" },
        { "rel": ".node_repl_history", "note": "node 历史" },
        { "rel": ".ganttproject", "note": "GanttProject 配置" },
        { "rel": ".pcr-stats.json", "note": "PCR 统计" },
        { "rel": ".rnd", "note": "随机状态文件" }
      ]
    },
    {
      "id": "browsers",
      "name": "浏览器书签/偏好/历史",
      "default": true,
      "browsers": [
        { "rel": "AppData\\Local\\Microsoft\\Edge\\User Data", "label": "Edge" },
        { "rel": "AppData\\Local\\Google\\Chrome\\User Data", "label": "Chrome" }
      ],
      "profileFiles": [
        "Bookmarks",
        "Preferences",
        "Secure Preferences",
        "Login Data",
        "Login Data For Account",
        "Web Data",
        "History",
        "Favicons",
        "Top Sites"
      ]
    },
    {
      "id": "system",
      "name": "系统项（hosts / 环境变量 / 软件清单）",
      "default": true,
      "system": {
        "files": [
          { "path": "C:\\Windows\\System32\\drivers\\etc\\hosts", "name": "hosts" }
        ],
        "regExports": [
          { "key": "HKCU\\Environment", "name": "用户环境变量（含 PATH）.reg" },
          { "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment", "name": "系统环境变量（含 PATH）.reg" },
          { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall", "name": "用户级已装软件.reg" },
          { "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall", "name": "机器级已装软件.reg" }
        ],
        "wingetExport": true,
        "environmentSnapshot": true
      }
    },
    {
      "id": "joplin",
      "name": "Joplin 笔记库",
      "default": false,
      "external": {
        "script": "备份Joplin.py",
        "variants": [
          { "id": "quick", "name": "不含附件（约 190 MB）", "args": ["--run"] },
          { "id": "full", "name": "含 4.5 GB 附件", "args": ["--run", "--with-resources"] }
        ]
      }
    }
  ]
}
