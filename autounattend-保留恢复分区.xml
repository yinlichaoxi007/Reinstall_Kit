<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows 10 IoT Enterprise LTSC 2021 无人值守应答文件（保留 Dell 恢复分区版）
  ============================================================================
  ⚠️ 本文件未做整机实机验证。其余应答文件都验证过，这个没有。
     原理：WillWipeDisk=false，只对现有 3 号分区做 Format NTFS，
           不新建分区、不碰 ESP / MSR / 三个 Dell 恢复分区。
     更稳妥的等价做法：用 autounattend-手动分区-IoT-LTSC.xml，
           在安装界面里手动只删 C 分区 —— 看得见、可核对。

  使用前提：磁盘 0 的分区布局必须与模板一致（P3 是原系统分区）
       P1 ESP / P2 MSR / P3 OS（原系统分区）
       P4 WINRETOOLS / P5 Image / P6 DELLSUPPORT（Dell 恢复分区）
     布局不符时安装程序会停下报错（WillShowUI=OnError），不会误抹。

  已知副作用：
     · ESP 不重写 → 旧系统的 BCD 条目会残留，指向已格式化的 C:，
       属无害死条目，装完可用 bcdedit 清理（可选）。
     · 没有空余空间建新的恢复分区 → WinRE 会落到 C:\Recovery\WindowsRE，
       或复用 P4。功能不受影响，但不再有独立恢复分区。

  上机前必须核对镜像名：
     dism /Get-WimInfo /WimFile:X:\sources\install.wim
     选 Windows 10 IoT Enterprise LTSC 2021（支持到 2032-01-13），
     不要选 Windows 10 Enterprise LTSC 2021（2027-01-12 就结束）。

  如需修改密码：搜索 <Password>，把 <Value></Value> 填上（U 盘请自行保管）
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend"
          xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">

  <!-- ============================ 1. windowsPE ============================ -->
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS">
      <SetupUILanguage>
        <UILanguage>zh-CN</UILanguage>
      </SetupUILanguage>
      <InputLocale>0804:00000804</InputLocale>
      <SystemLocale>zh-CN</SystemLocale>
      <UILanguage>zh-CN</UILanguage>
      <UserLocale>zh-CN</UserLocale>
    </component>

    <component name="Microsoft-Windows-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS">

            <DiskConfiguration>
        <WillShowUI>OnError</WillShowUI>
        <Disk wcm:action="add">
          <DiskID>0</DiskID>
          <!-- 关键：不整盘抹除，只格式化现有的 3 号分区（C:） -->
          <WillWipeDisk>false</WillWipeDisk>
          <ModifyPartitions>
            <!-- 只改 C:；ESP / MSR / 三个 Dell 恢复分区一律不动 -->
            <ModifyPartition wcm:action="add">
              <Order>1</Order>
              <PartitionID>3</PartitionID>
              <Letter>C</Letter>
              <Format>NTFS</Format>
              <Label>Windows</Label>
            </ModifyPartition>
          </ModifyPartitions>
        </Disk>
      </DiskConfiguration>

      <ImageInstall>
        <OSImage>
          <InstallFrom>
            <MetaData wcm:action="add">
              <Key>/IMAGE/NAME</Key>
              <Value>Windows 10 IoT Enterprise LTSC 2021</Value>
            </MetaData>
          </InstallFrom>
          <InstallTo>
            <DiskID>0</DiskID>
            <PartitionID>3</PartitionID>
          </InstallTo>
          <WillShowUI>OnError</WillShowUI>
        </OSImage>
      </ImageInstall>

      <UserData>
        <AcceptEula>true</AcceptEula>
        <FullName>__USER__</FullName>
        <Organization></Organization>
      </UserData>
    </component>
  </settings>

  <!-- ============================ 2. specialize ============================ -->
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS">
      <ComputerName>__COMPUTERNAME__</ComputerName>
      <TimeZone>China Standard Time</TimeZone>
      <RegisteredOwner>__USER__</RegisteredOwner>
      <RegisteredOrganization></RegisteredOrganization>
    </component>

    <component name="Microsoft-Windows-Deployment"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS">
      <RunSynchronous>
        <!-- 关闭开始菜单里的推广/建议 -->
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" /v DisableWindowsConsumerFeatures /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <!-- 关闭 Cortana -->
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\Windows Search" /v AllowCortana /t REG_DWORD /d 0 /f</Path>
        </RunSynchronousCommand>
        <!-- 开启 Win32 长路径支持（开发用得上） -->
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>reg add "HKLM\SYSTEM\CurrentControlSet\Control\FileSystem" /v LongPathsEnabled /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <!-- 高性能电源计划 -->
        <RunSynchronousCommand wcm:action="add">
          <Order>4</Order>
          <Path>powercfg /setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c</Path>
        </RunSynchronousCommand>
        <!-- 禁用休眠，省 16GB 的 C 盘空间 -->
        <RunSynchronousCommand wcm:action="add">
          <Order>5</Order>
          <Path>powercfg /hibernate off</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>

  <!-- ============================ 3. oobeSystem =========================== -->
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS">
      <InputLocale>0804:00000804</InputLocale>
      <SystemLocale>zh-CN</SystemLocale>
      <UILanguage>zh-CN</UILanguage>
      <UserLocale>zh-CN</UserLocale>
    </component>

    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS">

      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <NetworkLocation>Work</NetworkLocation>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>

      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Password>
              <Value></Value>
              <PlainText>true</PlainText>
            </Password>
            <Description>本机管理员</Description>
            <DisplayName>__USER__</DisplayName>
            <Group>Administrators</Group>
            <Name>__USER__</Name>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>

      <!-- 自动登录 1 次，只为了让 FirstLogonCommands 跑起来；跑完自动关闭 -->
      <AutoLogon>
        <Password>
          <Value></Value>
          <PlainText>true</PlainText>
        </Password>
        <Username>__USER__</Username>
        <Enabled>true</Enabled>
        <LogonCount>1</LogonCount>
      </AutoLogon>

      <FirstLogonCommands>
        <!-- 在 D/E/F/G/H 里找工程包目录，找到就跑 bootstrap.cmd；不写死盘符 -->
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Description>Reinstall Kit Bootstrap</Description>
          <CommandLine>cmd.exe /c for %d in (D E F G H) do @if exist "%d:\__KITNAME__\bootstrap.cmd" (call "%d:\__KITNAME__\bootstrap.cmd" &amp; exit /b 0)</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
      </FirstLogonCommands>

    </component>
  </settings>

</unattend>
